---
// The catalogue: every visible product, each one its model and its AR button - the same
// two things as a product page (/m/<token>), repeated. Name under each so a shopper can
// tell them apart; nothing else (Temo, 2026-10-23).
//
// Products are the `shopping3d` tenant's items, read through `public_menu` - the same
// function a restaurant menu uses, so hidden products, unapproved models and the order set
// in the admin all behave exactly as they do there.
import { envFrom } from "../lib/env.js";

export const prerender = false;
const SLUG = "shopping3d";

const env = envFrom(Astro.locals);
let products = [];
try {
  const url = env("SUPABASE_URL").replace(/\/$/, "");
  const key = env("SUPABASE_ANON_KEY");
  const res = await fetch(`${url}/rest/v1/rpc/public_menu`, {
    method: "POST",
    headers: { apikey: key, Authorization: `Bearer ${key}`, "Content-Type": "application/json" },
    body: JSON.stringify({ p_slug: SLUG }),
  });
  if (res.ok) {
    const doc = await res.json();
    const asset = (v) => (!v ? "" : /^(https?:)?\/\//.test(v) ? v : `/a/${v}`);
    products = (doc.items || [])
      .filter((r) => r.is_3d !== false && r.tenant_state === "approved" && (r.draco_key || r.external_glb))
      .sort((a, b) => (a.position ?? 0) - (b.position ?? 0))
      .map((r) => ({
        id: r.id, name: r.name,
        glb: asset(r.draco_key || r.external_glb),
        usdz: asset(r.usdz_key || r.external_usdz),
      }));
  }
} catch (err) {
  console.error("[shopping3d] catalogue failed", err);
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Shopping 3D</title>
    <style>
      body { margin: 0; background: #fff; color: #111; font: 16px/1.4 system-ui, -apple-system, sans-serif; }
      main { max-width: 1100px; margin: 0 auto; padding: 16px; display: grid; gap: 16px;
             grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
      .card { border: 1px solid #e5e5e5; border-radius: 14px; overflow: hidden; }
      model-viewer { width: 100%; height: 300px; --poster-color: #f6f6f6; background: #f6f6f6; }
      .ar { position: absolute; left: 12px; right: 12px; bottom: 12px; padding: 14px; border: 0;
            border-radius: 12px; background: #111; color: #fff; font: 700 16px/1 system-ui, sans-serif; }
      .name { padding: 12px 14px; font-weight: 600; }
      .empty { padding: 40px 16px; color: #666; }
    </style>
    <script type="module" src="https://cdnjs.cloudflare.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>
  </head>
  <body>
    {products.length ? (
      <main>
        {products.map((p) => (
          <div class="card">
            <model-viewer src={p.glb} ios-src={p.usdz || undefined} alt={p.name}
                          loading="lazy" ar ar-modes="webxr scene-viewer quick-look" ar-scale="fixed"
                          camera-controls touch-action="pan-y" shadow-intensity="1">
              <button slot="ar-button" class="ar">View in your space</button>
            </model-viewer>
            <div class="name">{p.name}</div>
          </div>
        ))}
      </main>
    ) : (
      <p class="empty">No products yet.</p>
    )}
  </body>
</html>
