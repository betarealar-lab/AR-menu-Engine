# Copy to .env for local work. NEVER commit the real file.

# Meshy - create at https://meshy.ai/settings/api (shown once)
MESHY_API_KEY=msy_your_key_here

# Cloudflare R2. Omit all of these and the Studio writes to ./store instead.
# Paste the endpoint URL from the R2 token screen verbatim - Cloudflare does not label
# an "Account ID" field, it is just the first chunk of that URL.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCOUNT_ID=          (alternative to R2_ENDPOINT, if you prefer)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_PHOTOS=betareal-photos
# R2_BUCKET_MODELS=betareal-models

# Shared logins. Empty = no auth, which is fine locally and never fine hosted.
# STUDIO_USERS=temo:somepassword,niko:somepassword

# The two new buckets, for the self-serve menu half. Both PRIVATE - the Worker binds
# them directly, so neither needs public access or a custom domain. See MENU-PLATFORM
# section 2.6 for why, and section 7 for the DNS reason it matters.
# R2_BUCKET_CATALOG=betareal-catalog
# R2_BUCKET_MENUS=betareal-menus

# Supabase, on the BETAREAL account - never Niko's project (lwdpegloznhpcecivhfy).
# Dashboard -> Project Settings -> API (newer UI: API Keys).
#   SUPABASE_URL          "Project URL"
#   SUPABASE_ANON_KEY     the "anon"/"public" (or "publishable") key. Ships in the
#                         browser BY DESIGN - which is only safe because RLS is on.
#                         That is why "Enable automatic RLS" must be ticked.
#   SUPABASE_SERVICE_KEY  the "service_role"/"secret" key. BYPASSES RLS COMPLETELY.
#                         Server-side only. Never in the browser, never in the repo.
#   SUPABASE_DB_URL       Settings -> Database -> Connection string -> URI. Contains
#                         the database password; needed to run migrations.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
# SUPABASE_DB_URL=postgresql://postgres:<password>@<host>:5432/postgres
