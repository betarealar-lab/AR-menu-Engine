---
// Choosing a password, from a one-time link.
//
// This is the whole account-creation flow: `menu/make_admin.py` makes the account and
// prints a link to here. There is no signup route (DECISIONS §9.3) and no password is ever
// chosen, printed or stored by us - the person picks their own and Supabase holds it.
//
// The token is in the query string and is exchanged server-side by `/api/set-password`, so
// nothing here reads or holds it, and the person is signed in when it finishes rather than
// bounced to a login form to retype what they just chose.
import "../../styles/admin.css";

const token = Astro.url.searchParams.get("token") || "";
const email = Astro.url.searchParams.get("email") || "";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Set your password · BetaReal</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <div class="topbar"><h1>Set your password</h1></div>

    <main>
      {!token || !email ? (
        <div class="card">
          <p class="error">That link is missing something.</p>
          <p class="hint" style="margin-bottom:0">Ask for a new one and open it whole -
            some chat apps cut long links in half.</p>
        </div>
      ) : (
        <form id="set">
          <div class="card">
            <p class="hint" style="margin-top:0">for {email}</p>
            <label>
              <span>Password</span>
              <input type="password" name="password" required minlength="8" autofocus
                     autocomplete="new-password" />
            </label>
            <label>
              <span>Again</span>
              <input type="password" name="again" required minlength="8"
                     autocomplete="new-password" />
            </label>
            <p class="hint">At least 8 characters. Use a password manager - this is the
              only thing standing in front of every restaurant you can edit.</p>
            <button type="submit" class="btn" style="width:100%">Set it and sign in</button>
          </div>
        </form>
      )}
    </main>

    <div class="saved" id="saved" role="status" aria-live="polite"></div>

    <script is:inline define:vars={{ token, email }}>
      const form = document.getElementById("set");
      const note = document.getElementById("saved");
      function flash(text, bad) {
        note.textContent = text;
        note.className = "saved show" + (bad ? " bad" : "");
      }
      form?.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        const password = form.password.value;
        if (password !== form.again.value) return flash("Those do not match", true);
        const btn = form.querySelector("button");
        btn.disabled = true;
        try {
          const r = await fetch("/api/set-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, email, password }),
          });
          if (!r.ok) throw new Error((await r.text()).slice(0, 160));
          location.href = "/admin";
        } catch (err) {
          btn.disabled = false;
          flash(err.message, true);
        }
      });
    </script>
  </body>
</html>
