---
// Capturing a dish for 3D. Four photos, in the engine's own slot order.
//
// Its own screen rather than a section of the dish editor, because it is the one thing an
// owner does standing over a plate with a phone in one hand, and it wants the whole
// screen. It is also the only screen in the panel that spends money, which is a good
// reason for it not to be a control somebody brushes past on the way to a price.
//
// The guidance is not decoration. `front` is the primary view the generator reconstructs
// from first (dataset.SLOT_ROLE); the other three are coverage. A set of four photos taken
// from the same angle produces a confident, wrong model, and the only place to prevent
// that is here, before the credits are spent.
import Admin from "../../../../../layouts/Admin.astro";
import { requireUser, userClient } from "../../../../../lib/auth.js";

const gate = await requireUser(Astro);
if (gate) return gate;
const { slug, id } = Astro.params;
const supa = userClient(Astro.locals.user.token);

const { data: tenant } = await supa
  .from("tenants").select("id, name, model_quota").eq("slug", slug).single();
if (!tenant) return new Response("Not found", { status: 404 });

const { data: item } = await supa.from("items")
  .select("id, name, model_id").eq("id", id).single();
if (!item) return new Response("Not found", { status: 404 });

// An open request for this dish, if there is one. The partial unique index in 0007 means
// there can be at most one, which is what lets this be a single object rather than a list.
const { data: open } = await supa.from("model_requests")
  .select("id, state, note, photo_keys, requested_utc")
  .eq("item_id", id).in("state", ["pending", "approved", "running"])
  .maybeSingle();

const { data: used } = await supa.rpc("model_requests_used", { t: tenant.id });
const left = Math.max(0, (tenant.model_quota ?? 0) - (used ?? 0));

const SLOTS = [
  ["front", "Front", "Straight on, at about the height a diner sees it. This is the one the generator builds from first, so it is the one worth getting right."],
  ["right", "Right", "A quarter turn clockwise. Same distance, same light."],
  ["back", "Back", "The opposite side. Yes, even if it looks the same - it is what stops the far side being invented."],
  ["left", "Left", "A quarter turn the other way, and you are done."],
];
---
<Admin title="3D model" tab="models" slug={slug} back={`/admin/${slug}/item/${id}`}>
  <div class="card">
    <h2>{item.name}</h2>
    {open ? (
      <p class="hint" style="margin:0">
        {open.state === "running"
          ? "Being built now. It appears in your 3D library when it is ready."
          : open.state === "approved"
            ? "In the queue. It appears in your 3D library when it is ready."
            : open.note || "Waiting for us to approve this one."}
      </p>
    ) : (
      <p class="hint" style="margin:0">Four photos of the dish, from four sides. Good even
        light, no hands in shot, and the plate filling most of the frame.</p>
    )}
  </div>

  {!open && (
    <>
      <form id="capture">
        {SLOTS.map(([key, label, help], i) => (
          <div class="card slot" data-slot={i}>
            <h2>{i + 1}. {label}</h2>
            <div class="shot"><p class="hint" style="margin:0">Not taken yet</p></div>
            <input type="file" accept="image/*" capture="environment"
                   id={`f-${i}`} style="display:none" />
            <div class="actions">
              <button type="button" class="btn ghost grow"
                      onclick={`document.getElementById('f-${i}').click()`}>Take photo</button>
            </div>
            <p class="hint" style="margin-bottom:0">{help}</p>
          </div>
        ))}
      </form>

      <div class="card">
        <button type="button" class="btn" id="send" style="width:100%" disabled>
          Send for modelling
        </button>
        <p class="hint" style="margin-bottom:0">
          {left > 0
            ? `${left} of your ${tenant.model_quota} models left. It takes a few minutes, `
              + "and it lands in your 3D library for you to approve or reject."
            : "You have used all your models. Send this and we will look at it — it will "
              + "not start until we say yes."}
        </p>
      </div>
    </>
  )}

  {open && (
    <div class="card">
      <button type="button" class="danger" id="cancel" style="width:100%">
        Cancel this request
      </button>
    </div>
  )}

  <script is:inline define:vars={{ slug, itemId: id, requestId: open?.id ?? null }}>
    (function () {
      const keys = [null, null, null, null];

      async function shrink(file) {
        // 2048px, JPEG. Bigger than a menu photo on purpose: this is engine input, and
        // whatever detail is thrown away here is the ceiling on the model forever. Still
        // resized, because a modern phone hands over 12 MB and none of it past 2048px
        // reaches the generator anyway.
        const bmp = await createImageBitmap(file);
        const w = Math.min(2048, bmp.width);
        const c = document.createElement("canvas");
        c.width = w;
        c.height = Math.round(bmp.height * (w / bmp.width));
        c.getContext("2d").drawImage(bmp, 0, 0, c.width, c.height);
        return new Promise((r) => c.toBlob(r, "image/jpeg", 0.92));
      }

      function ready() {
        // One photo is enough to ask - four is enough to get a good answer. The button
        // enables on the first, because refusing to let somebody try is worse than a
        // model built from two angles, and the copy already told them why four is better.
        document.getElementById("send").disabled = !keys.some(Boolean);
      }

      document.querySelectorAll(".slot").forEach((card) => {
        const i = Number(card.dataset.slot);
        card.querySelector("input[type=file]").addEventListener("change", async (ev) => {
          const file = ev.target.files?.[0];
          if (!file) return;
          const shot = card.querySelector(".shot");
          shot.innerHTML = '<p class="hint" style="margin:0">Uploading…</p>';
          try {
            const blob = await shrink(file);
            const fd = new FormData();
            fd.append("file", blob, "frame.jpg");
            fd.append("slug", slug);
            fd.append("slot", String(i));
            const r = await fetch("/api/capture", { method: "POST", body: fd });
            if (!r.ok) throw new Error((await r.text()).slice(0, 120));
            const { key, url } = await r.json();
            keys[i] = key;
            shot.innerHTML = `<img src="${url}" alt="" style="width:100%;border-radius:10px">`;
            ready();
          } catch (err) {
            shot.innerHTML = '<p class="hint" style="margin:0">Not uploaded</p>';
            BR.flash("Upload failed: " + err.message, true);
          }
        });
      });

      const send = document.getElementById("send");
      send?.addEventListener("click", async () => {
        send.disabled = true;
        send.textContent = "Sending…";
        try {
          const res = await BR.post("/api/model-request", {
            slug, item_id: itemId, photo_keys: keys.filter(Boolean),
          });
          BR.flash(res.state === "pending"
            ? "Sent. We will approve it shortly."
            : "Sent. It is being built now.");
          location.reload();
        } catch (err) {
          send.disabled = false;
          send.textContent = "Send for modelling";
          BR.flash("Not sent: " + err.message, true);
        }
      });

      document.getElementById("cancel")?.addEventListener("click", async () => {
        if (!confirm("Cancel this request?")) return;
        try {
          await BR.post("/api/model-request", { slug, id: requestId, _cancel: true });
          location.reload();
        } catch (err) {
          BR.flash("Not cancelled: " + err.message, true);
        }
      });
    })();
  </script>
</Admin>
