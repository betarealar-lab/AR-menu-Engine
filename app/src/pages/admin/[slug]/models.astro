---
// The 3D library: everything the engine has made for this restaurant, and the owner's
// verdict on each.
//
// DECISIONS §9.4 - the owner approves or rejects, and only approved models can be
// attached to a dish. Our own fault tags never appear here: "this does not look like my
// dish" and "this bake is broken" are different sentences, and a panel that mixed them
// would teach us the wrong thing about the engine.
import Admin from "../../../layouts/Admin.astro";
import { requireUser, userClient } from "../../../lib/auth.js";

const gate = await requireUser(Astro);
if (gate) return gate;
const { slug } = Astro.params;
const supa = userClient(Astro.locals.user.token);

const { data: tenant } = await supa
  .from("tenants").select("id, name").eq("slug", slug).single();
if (!tenant) return new Response("Not found", { status: 404 });

const [{ data: models }, { data: items }, { data: requests }] = await Promise.all([
  supa.from("models")
      .select("id, title, dish, variant, poster_key, draco_key, view_orbit, tenant_state, created_utc")
      .eq("tenant_id", tenant.id).order("created_utc", { ascending: false }),
  supa.from("items").select("id, name, model_id").eq("tenant_id", tenant.id),
  // What is on the way. Shown FIRST, because "where is the model I asked for" is the
  // question this screen exists to answer and an empty library is not an answer to it.
  supa.from("model_requests")
      .select("id, title, state, note, item_id, requested_utc")
      .eq("tenant_id", tenant.id)
      .in("state", ["pending", "approved", "running", "failed"])
      .order("requested_utc", { ascending: false }),
]);

const WAITING = {
  pending:  "Waiting for us to approve it",
  approved: "In the queue",
  running:  "Being built now",
  failed:   "Did not work",
};

// Which dish is using which model. The pointer lives on the item, not the model
// (MENU-PLATFORM §3), so this is the only place that relationship can be read from.
const usedBy = new Map();
for (const i of items || []) if (i.model_id) usedBy.set(i.model_id, i);

const asset = (k) => (!k ? null : k.startsWith("http") ? k : `/a/${k}`);
const groups = [
  ["draft", "Waiting for you", (models || []).filter((m) => m.tenant_state === "draft")],
  ["approved", "Approved", (models || []).filter((m) => m.tenant_state === "approved")],
  ["rejected", "Rejected", (models || []).filter((m) => m.tenant_state === "rejected")],
];
---
<Admin title="3D models" tab="models" slug={slug} back={`/admin/${slug}/menu`}>
  {(requests || []).length > 0 && (
    <div class="card">
      <h2>On the way · {requests.length}</h2>
      <ul class="rows">
        {requests.map((r) => (
          <li>
            <div class="row">
              <div class="thumb"></div>
              <div class="body">
                <b>{r.title || "Dish"}</b>
                <small>{r.state === "failed" && r.note ? r.note : WAITING[r.state]}</small>
              </div>
              {r.item_id && (
                <a class="chev" href={`/admin/${slug}/item/${r.item_id}/3d`}>&#8250;</a>
              )}
            </div>
          </li>
        ))}
      </ul>
      <p class="hint" style="margin:14px 0 0">A model takes a few minutes. It lands below
        for you to approve before any diner sees it.</p>
    </div>
  )}

  {(models || []).length === 0 && (requests || []).length === 0 && (
    <div class="empty">
      <p>No 3D models yet.</p>
      <p class="hint">Send us photos of a dish and it appears here for you to approve.</p>
    </div>
  )}

  {groups.map(([state, title, list]) => list.length > 0 && (
    <div class="card">
      <h2>{title} · {list.length}</h2>
      <ul class="rows">
        {list.map((m) => (
          <li data-id={m.id}>
            <div class="row" style="align-items:flex-start">
              {asset(m.poster_key)
                ? <img src={asset(m.poster_key)} alt="" loading="lazy" />
                : <div class="thumb"></div>}
              <div class="body">
                <b>{m.title || m.dish}</b>
                <small>
                  {usedBy.has(m.id)
                    ? `on ${usedBy.get(m.id).name}`
                    : m.variant !== "default" ? m.variant : "not on any dish"}
                </small>
                <div class="actions" style="margin-top:8px">
                  {state !== "approved" && (
                    <button type="button" class="btn verdict" data-state="approved">Approve</button>
                  )}
                  {state !== "rejected" && (
                    <button type="button" class="btn ghost verdict" data-state="rejected">Reject</button>
                  )}
                </div>

                {asset(m.draco_key) && (
                  <details class="angle" data-id={m.id} data-orbit={m.view_orbit || ""}>
                    <summary>Starting angle</summary>
                    <p class="hint" style="margin-top:0">Turn the dish to how it should
                      first appear, then save it. A bowl framed from its own rim is an
                      empty ellipse, and every diner sees whatever is set here.</p>
                    <div class="stage" data-src={asset(m.draco_key)}></div>
                    <div class="actions">
                      <button type="button" class="btn use">Use this angle</button>
                      <button type="button" class="btn ghost reset">Default</button>
                    </div>
                  </details>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
      {state === "approved" && (
        <p class="hint" style="margin:14px 0 0">Approved models are the ones you can pick
          on a dish. Rejecting one that is already on a dish takes it off the menu.</p>
      )}
    </div>
  ))}

  <!-- Only on this screen, and only because setting a camera angle by typing three
       numbers is a thing nobody will ever do correctly. It never reaches a diner's page -
       theirs already has its own copy, pinned to the same version production ships. -->
  <script type="module"
          src="https://cdnjs.cloudflare.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"
  ></script>

  <script is:inline define:vars={{ slug }}>
    // The viewer is created when the section is opened, not on page load: a 3D library
    // with twenty models would otherwise fetch twenty GLBs to show a list.
    document.querySelectorAll(".angle").forEach((box) => {
      const stage = box.querySelector(".stage");
      let mv = null;
      let framed = 0;                 // the radius model-viewer chose = 100% zoom

      box.addEventListener("toggle", () => {
        if (!box.open || mv) return;
        mv = document.createElement("model-viewer");
        mv.setAttribute("src", stage.dataset.src);
        mv.setAttribute("camera-controls", "");
        mv.setAttribute("touch-action", "pan-y");
        mv.setAttribute("interaction-prompt", "none");
        mv.setAttribute("loading", "eager");
        mv.style.cssText = "width:100%;height:260px;background:var(--sunk);border-radius:10px";
        if (box.dataset.orbit) {
          const p = box.dataset.orbit.trim().split(/\s+/).map(Number);
          if (p.length === 3 && p.every(Number.isFinite)) {
            mv.setAttribute("camera-orbit", `${p[0]}deg ${p[1]}deg ${p[2]}%`);
          }
        }
        // Whatever radius it settles on with no camera-orbit of ours IS 100%, which is
        // what makes a percentage readable back out of a metre measurement at all.
        mv.addEventListener("load", () => {
          const o = mv.getCameraOrbit();
          framed = box.dataset.orbit
            ? o.radius / (Number(box.dataset.orbit.trim().split(/\s+/)[2]) / 100)
            : o.radius;
        }, { once: true });
        stage.appendChild(mv);
      });

      box.querySelector(".use").addEventListener("click", async () => {
        if (!mv || !framed) return BR.flash("Give it a moment to load", true);
        const o = mv.getCameraOrbit();
        const deg = (rad) => Math.round((rad * 180) / Math.PI);
        // The renderer's own clamps (viewer.js _itemCameraOrbit), applied here so a saved
        // angle is one that will actually be used rather than silently discarded.
        const h = Math.max(-360, Math.min(360, deg(o.theta)));
        const v = Math.max(0, Math.min(85, deg(o.phi)));
        const zoom = Math.max(30, Math.min(300, Math.round((o.radius / framed) * 100)));
        try {
          await BR.post("/api/model", { slug, id: box.dataset.id,
                                        view_orbit: `${h} ${v} ${zoom}` });
          box.dataset.orbit = `${h} ${v} ${zoom}`;
          BR.flash("Angle saved");
        } catch (err) {
          BR.flash("Not saved: " + err.message, true);
        }
      });

      box.querySelector(".reset").addEventListener("click", async () => {
        try {
          await BR.post("/api/model", { slug, id: box.dataset.id, view_orbit: "" });
          box.dataset.orbit = "";
          mv?.removeAttribute("camera-orbit");
          BR.flash("Back to the default angle");
        } catch (err) {
          BR.flash("Not saved: " + err.message, true);
        }
      });
    });

    document.addEventListener("click", async (ev) => {
      const btn = ev.target.closest(".verdict");
      if (!btn) return;
      const li = btn.closest("li");
      btn.disabled = true;
      try {
        await BR.post("/api/model", { slug, id: li.dataset.id, tenant_state: btn.dataset.state });
        location.reload();
      } catch (err) {
        btn.disabled = false;
        BR.flash("Not saved: " + err.message, true);
      }
    });
  </script>
</Admin>
