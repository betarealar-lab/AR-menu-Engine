---
// The details: address, hours, phone, links, delivery, the announcement bar.
//
// Every field here is a key the live restaurants already use, read out of their own
// settings (`fields.js`). Nothing is invented, because the ported CSS and the renderer
// look for exactly these names.
import Admin from "../../../layouts/Admin.astro";
import { requireUser, userClient } from "../../../lib/auth.js";
import { SETTINGS_GROUPS } from "../../../lib/fields.js";

const gate = await requireUser(Astro);
if (gate) return gate;
const { slug } = Astro.params;
const supa = userClient(Astro.locals.user.token);

const { data: tenant } = await supa
  .from("tenants").select("id, name, slug, languages, settings").eq("slug", slug).single();
if (!tenant) return new Response("Not found", { status: 404 });

const s = tenant.settings || {};
const langs = tenant.languages || ["en"];
const isTrue = (v) => v === true || v === "true";
---
<Admin title="Details" tab="settings" slug={slug} back={`/admin/${slug}/menu`}>
  <form id="settings">
    <div class="card">
      <label>
        <span>Restaurant name</span>
        <input type="text" name="_name" value={tenant.name} />
      </label>
      <p class="hint">What this restaurant is called in your admin. The name diners see is
        below, under The restaurant.</p>
      <div class="switch">
        <span>Also in Georgian<small>Adds a second field to every dish and category.</small></span>
        <input type="checkbox" name="_ka" checked={langs.includes("ka")} />
      </div>
    </div>

    {SETTINGS_GROUPS.map((g) => (
      <div class="card">
        <h2>{g.title}</h2>
        {g.fields.map(([key, label, kind, hint]) => (
          kind === "bool" ? (
            <div class="switch">
              <span>{label}</span>
              <input type="checkbox" name={key} checked={isTrue(s[key])} />
            </div>
          ) : kind === "textarea" ? (
            <label>
              <span>{label}</span>
              <textarea name={key}>{s[key] || ""}</textarea>
              {hint && <p class="hint">{hint}</p>}
            </label>
          ) : (
            <label>
              <span>{label}</span>
              <input type={kind === "url" ? "url" : kind === "tel" ? "tel" : "text"}
                     name={key} value={s[key] || ""} placeholder={hint || ""} />
            </label>
          )
        ))}
      </div>
    ))}

    <div class="card">
      <h2>Address</h2>
      <p class="hint" style="margin-top:0">Diners reach this menu at</p>
      <p style="font-weight:600;word-break:break-all;margin:0">/{tenant.slug}</p>
      <p class="hint" style="margin-bottom:0">Changing this is a support job for now -
        every printed QR code points at the old one.</p>
    </div>
  </form>

  <script is:inline define:vars={{ slug }}>
    (function () {
      const form = document.getElementById("settings");

      function save() {
        const settings = {};
        for (const el of form.elements) {
          if (!el.name || el.name.startsWith("_")) continue;
          settings[el.name] = el.type === "checkbox" ? el.checked : el.value.trim();
        }
        const body = { slug, settings };
        const name = form.elements._name?.value.trim();
        if (name) body.name = name;
        body.languages = form.elements._ka?.checked ? ["en", "ka"] : ["en"];
        BR.save("/api/tenant", body, { key: "settings" });
      }

      form.addEventListener("input", save);
      form.addEventListener("change", save);
    })();
  </script>
</Admin>
