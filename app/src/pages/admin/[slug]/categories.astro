---
// Categories. Rename in place, reorder with the arrows, hide without deleting.
//
// Arrows rather than drag-and-drop, deliberately: dragging a row inside a scrolling page
// on a phone fights the scroll, and an owner reordering ten categories with a thumb wants
// a target they can hit, not a gesture they have to be taught.
import Admin from "../../../layouts/Admin.astro";
import { requireUser, userClient } from "../../../lib/auth.js";

const gate = await requireUser(Astro);
if (gate) return gate;
const { slug } = Astro.params;
const supa = userClient(Astro.locals.user.token);

const { data: tenant } = await supa
  .from("tenants").select("id, name").eq("slug", slug).single();
if (!tenant) return new Response("Not found", { status: 404 });

const [{ data: cats }, { data: items }] = await Promise.all([
  supa.from("categories").select("id, name, position, visible")
      .eq("tenant_id", tenant.id).order("position"),
  supa.from("items").select("category_id").eq("tenant_id", tenant.id),
]);

const counts = new Map();
for (const i of items || []) {
  counts.set(i.category_id, (counts.get(i.category_id) || 0) + 1);
}
---
<Admin title="Categories" tab="menu" slug={slug} back={`/admin/${slug}/menu`}>
  <div class="card">
    <h2>Add a category</h2>
    <div class="actions">
      <input type="text" id="new-name" placeholder="Starters" style="flex:1;min-width:0" />
      <button type="button" class="btn" id="add">Add</button>
    </div>
  </div>

  <div class="card" id="list-card">
    <h2>{(cats || []).length} categories</h2>
    {(cats || []).length === 0 ? (
      <p class="hint" style="margin:0">None yet. Dishes without a category still show,
        grouped under "No category".</p>
    ) : (
      <ul class="rows" id="cats">
        {(cats || []).map((c) => (
          <li data-id={c.id}>
            <div class="row" style="gap:8px">
              <div class="ord">
                <button type="button" class="mini up" aria-label="Move up">&#9650;</button>
                <button type="button" class="mini down" aria-label="Move down">&#9660;</button>
              </div>
              <div class="body">
                <input class="rename" type="text" value={c.name} aria-label="Category name" />
                <small>{counts.get(c.id) || 0} dishes</small>
              </div>
              <button type="button" class="mini eye" aria-pressed={String(!c.visible)}
                      aria-label="Show or hide">{c.visible ? "Shown" : "Hidden"}</button>
              <button type="button" class="mini del" aria-label="Delete">&#215;</button>
            </div>
          </li>
        ))}
      </ul>
    )}
    <p class="hint" style="margin:14px 0 0">Deleting a category keeps its dishes. They
      move to "No category" so you can re-file them.</p>
  </div>

  <script is:inline define:vars={{ slug }}>
    (function () {
      const list = document.getElementById("cats");

      function order() {
        if (!list) return;
        BR.post("/api/category", {
          slug, order: [...list.children].map((li) => li.dataset.id),
        }).then(() => BR.flash("Saved"))
          .catch((e) => BR.flash("Not saved: " + e.message, true));
      }

      list?.addEventListener("click", (ev) => {
        const btn = ev.target.closest("button");
        if (!btn) return;
        const li = btn.closest("li");
        const id = li.dataset.id;

        if (btn.classList.contains("up") && li.previousElementSibling) {
          li.parentNode.insertBefore(li, li.previousElementSibling);
          order();
        } else if (btn.classList.contains("down") && li.nextElementSibling) {
          li.parentNode.insertBefore(li.nextElementSibling, li);
          order();
        } else if (btn.classList.contains("eye")) {
          const nowVisible = btn.textContent.trim() === "Hidden";
          btn.textContent = nowVisible ? "Shown" : "Hidden";
          btn.setAttribute("aria-pressed", String(!nowVisible));
          BR.save("/api/category", { slug, id, visible: nowVisible },
                  { key: "cat-" + id, wait: 0 });
        } else if (btn.classList.contains("del")) {
          const name = li.querySelector(".rename").value;
          if (!confirm(`Delete "${name}"? Its dishes stay, without a category.`)) return;
          BR.post("/api/category", { slug, id, _delete: true })
            .then(() => { li.remove(); BR.flash("Deleted"); })
            .catch((e) => BR.flash("Not deleted: " + e.message, true));
        }
      });

      list?.addEventListener("input", (ev) => {
        const box = ev.target.closest(".rename");
        if (!box || !box.value.trim()) return;
        const id = box.closest("li").dataset.id;
        BR.save("/api/category", { slug, id, name: box.value.trim() },
                { key: "cat-" + id });
      });

      const name = document.getElementById("new-name");
      document.getElementById("add").addEventListener("click", async () => {
        const value = name.value.trim();
        if (!value) return name.focus();
        try {
          await BR.post("/api/category", { slug, name: value });
          location.reload();          // simplest correct thing: it lands in order
        } catch (e) {
          BR.flash("Not added: " + e.message, true);
        }
      });
      name.addEventListener("keydown", (ev) => {
        if (ev.key === "Enter") { ev.preventDefault(); document.getElementById("add").click(); }
      });
    })();
  </script>
</Admin>
