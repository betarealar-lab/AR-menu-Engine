---
// The look: template, colours, fonts, logo, hero.
//
// Colours are split day/night because that is how they are stored - the live restaurants
// carry 34 keys of each, and editing "the accent" without saying which mode would silently
// write one and leave the other wrong. The toggle at the top is the whole mechanism.
//
// Six colours are in front and the other twenty-eight are behind "More colours". An owner
// changes the accent; somebody eventually needs the badge colour, and hiding it entirely
// would mean a support request.
import Admin from "../../../layouts/Admin.astro";
import { requireUser, userClient } from "../../../lib/auth.js";
import { PALETTE_MAIN, PALETTE_REST, LOOK_FIELDS, LOOK_CHOICE } from "../../../lib/fields.js";

const gate = await requireUser(Astro);
if (gate) return gate;
const { slug } = Astro.params;
const supa = userClient(Astro.locals.user.token);

const { data: tenant } = await supa
  .from("tenants").select("id, name, slug, theme, settings, template_id")
  .eq("slug", slug).single();
if (!tenant) return new Response("Not found", { status: 404 });

// Only listed templates are offered, but the one this restaurant already uses is always
// in the list - otherwise switching away from an unlisted template would be a one-way door.
const { data: templates } = await supa.from("templates")
  .select("id, name, listed").order("name");
const choices = (templates || [])
  .filter((t) => t.listed || t.id === tenant.template_id);

const theme = tenant.theme || {};
const s = tenant.settings || {};
const val = (mode, key) => theme[`${mode}_${key}`] ?? theme[key] ?? "";
const hex = (v) => (/^#[0-9a-fA-F]{6}$/.test(v) ? v : "#000000");
---
<Admin title="Look" tab="look" slug={slug} back={`/admin/${slug}/menu`}>
  <a slot="action" class="btn ghost" href={`/${slug}`} target="_blank" rel="noopener"
     style="padding:8px 12px">View</a>

  <div class="card">
    <h2>Template</h2>
    <label>
      <span>Design</span>
      <select id="template">
        {choices.map((t) => (
          <option value={t.id} selected={t.id === tenant.template_id}>{t.name}</option>
        ))}
      </select>
    </label>
    <p class="hint">The template is the shape of the page. The colours below are painted
      over it, so switching keeps everything you have set.</p>
  </div>

  <div class="card">
    <h2>Colours</h2>
    <div class="modes" role="tablist">
      <button type="button" class="mode on" data-mode="night" role="tab">Night</button>
      <button type="button" class="mode" data-mode="day" role="tab">Day</button>
    </div>

    {["night", "day"].map((mode) => (
      <div class="pane" data-pane={mode} hidden={mode !== "night"}>
        {PALETTE_MAIN.map(([key, label]) => (
          <div class="colour">
            <input type="color" value={hex(val(mode, key))} data-for={`${mode}_${key}`}
                   aria-label={`${label} swatch`} />
            <div class="body">
              <b>{label}</b>
              <input type="text" name={`${mode}_${key}`} value={val(mode, key)}
                     placeholder="template default" aria-label={label} />
            </div>
          </div>
        ))}

        <details>
          <summary>More colours</summary>
          {PALETTE_REST.map(([key, label]) => (
            <div class="colour">
              <input type="color" value={hex(val(mode, key))} data-for={`${mode}_${key}`}
                     aria-label={`${label} swatch`} />
              <div class="body">
                <b>{label}</b>
                <input type="text" name={`${mode}_${key}`} value={val(mode, key)}
                       placeholder="template default" aria-label={label} />
              </div>
            </div>
          ))}
          <p class="hint">Gradients, images and shadows go in the text box - the swatch
            only writes a flat colour. Empty means "whatever the template says".</p>
        </details>
      </div>
    ))}
  </div>

  <form id="look">
    <div class="card">
      <h2>Pictures and fonts</h2>
      {LOOK_FIELDS.map(([key, label, kind]) => (
        <label>
          <span>{label}</span>
          {kind === "font"
            ? <input type="text" name={key} value={s[key] || ""}
                     placeholder="Nunito" list="fonts" />
            : <input type="url" name={key} value={s[key] || ""} placeholder="https://…" />}
        </label>
      ))}
      <datalist id="fonts">
        {["Nunito", "Fraunces", "Lato", "Playfair Display", "Inter", "Montserrat",
          "Poppins", "Manrope", "Cormorant Garamond"].map((f) => <option value={f} />)}
      </datalist>
      <p class="hint">Font names are Google Fonts names, spelled the same way. A name we
        cannot find falls back to the template's font rather than breaking the page.</p>
    </div>

    <div class="card">
      <h2>Behaviour</h2>
      {LOOK_CHOICE.map(([key, label, options]) => (
        <label>
          <span>{label}</span>
          <select name={key}>
            {options.map(([v, text]) => (
              <option value={v} selected={(s[key] || "") === v}>{text}</option>
            ))}
          </select>
        </label>
      ))}
    </div>
  </form>

  <script is:inline define:vars={{ slug }}>
    (function () {
      const card = document.querySelector(".modes").closest(".card");

      card.querySelectorAll(".mode").forEach((btn) => {
        btn.addEventListener("click", () => {
          card.querySelectorAll(".mode").forEach((b) => b.classList.remove("on"));
          btn.classList.add("on");
          card.querySelectorAll(".pane").forEach((p) => {
            p.hidden = p.dataset.pane !== btn.dataset.mode;
          });
        });
      });

      function saveTheme() {
        const theme = {};
        card.querySelectorAll('input[type="text"][name]').forEach((el) => {
          theme[el.name] = el.value.trim();
        });
        BR.save("/api/tenant", { slug, theme }, { key: "theme" });
      }

      // The swatch writes into the text box rather than being a second source of truth -
      // a value here can be a gradient, and only the text box can hold one.
      card.addEventListener("input", (ev) => {
        const el = ev.target;
        if (el.type === "color") {
          const box = card.querySelector(`input[name="${el.dataset.for}"]`);
          if (box) box.value = el.value;
        } else if (el.type === "text" && /^#[0-9a-fA-F]{6}$/.test(el.value.trim())) {
          const sw = card.querySelector(`input[type="color"][data-for="${el.name}"]`);
          if (sw) sw.value = el.value.trim();
        }
        saveTheme();
      });

      document.getElementById("template").addEventListener("change", (ev) => {
        BR.save("/api/tenant", {
          slug, template_id: ev.target.value,
          // The renderer reads `template_key` out of settings, the way the live
          // restaurants store it. Both are written so neither can go stale.
          settings: { template_key: ev.target.value },
        }, { key: "template", wait: 0 });
      });

      const form = document.getElementById("look");
      function saveLook() {
        const settings = {};
        for (const el of form.elements) {
          if (el.name) settings[el.name] = el.value.trim();
        }
        BR.save("/api/tenant", { slug, settings }, { key: "look" });
      }
      form.addEventListener("input", saveLook);
      form.addEventListener("change", saveLook);
    })();
  </script>
</Admin>
