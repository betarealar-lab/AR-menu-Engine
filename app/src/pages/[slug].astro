---
// The menu, rendered on the server.
//
// This is the whole point of the rebuild, and it is one idea: **the dishes are in the
// HTML.** Measured on the live page, a diner today waits ~1,010 ms for 646 KB of inline
// CSS and JS to parse, and then another ~890 ms for the menu to arrive over the network -
// about 2.1 seconds before anything readable exists. Here the browser receives a finished
// menu and paints it with no JavaScript at all.
//
// What is deferred, and why nothing important is:
//   the viewer + XR (106 KB)  one cached file, shared by every tenant, loaded after
//                             paint. A diner reads the menu while it arrives.
//   model-viewer (~250 KB)    from the CDN, on demand, exactly as the platform does it.
//   the models themselves     as thumbnails scroll into view, throttled.
//
// The CSS is trimmed per template - 347 KB down to ~114 KB - and the cut is a PROOF, not
// a guess: only rules scoped to another template or tenant are removed, and those cannot
// match this page. Hand-picking "unused" rules is what produced four separate "renders
// but looks wrong" bugs; trimming the generic remainder waits for a computed-style diff
// against the live page to prove each further cut.
import { envFrom } from "../lib/env.js";
import { loadMenu, themeMode } from "../lib/menu.js";
import { paletteCss, settingsCss, fontLinks } from "../lib/theme.js";
import { hero, header, catBar, menuList, toggles, itemsJson } from "../lib/markup.js";
// The platform's overlay markup, extracted verbatim (menu/render/extract_chrome.py):
// the 3D modal, the WebXR controls, the photo lightbox, the basket and the staff QR.
//
// **It is imported, not written.** `viewer.js` binds `#modal-spin` at top level on its
// 18th line; with that element absent the TypeError aborts the whole block and takes the
// 3D viewer, AR, the thumbnail upgrades and the basket with it - silently, on a page that
// otherwise looks finished. That is what shipped, and `chrome.html` is the fix.
import chromeHtml from "../../../menu/render/ported/chrome.html?raw";
// One sheet per template, trimmed by `menu/render/trim_css.py`. The cut is only ever
// rules scoped to ANOTHER template or tenant - those provably cannot match this page, so
// it is a proof rather than the guess that produced four "renders but looks wrong" bugs.
// 347 KB down to ~114 KB, and the remaining generic rules stay until a computed-style
// diff against the live page can prove each further cut.
import mondayGreensCss from "../lib/css/monday_greens.css?raw";
import elegantBlackCss from "../lib/css/elegant_black.css?raw";

const SHEETS = {
  monday_greens: mondayGreensCss,
  elegant_black: elegantBlackCss,
};
// Only two templates matter now - Monday Greens, and Corner at Tabidze on elegant_black.
// Everything else waits for a later generation. A restaurant with no template chosen gets
// Monday Greens, so a brand-new tenant has something coherent to look at rather than
// unstyled markup.
const DEFAULT_TEMPLATE = "monday_greens";

const { slug } = Astro.params;
const started = Date.now();

let menu = null;
let error = null;
try {
  menu = await loadMenu(slug, { assetBase: "/a", locals: Astro.locals });
} catch (err) {
  error = err.message;
}

if (!menu && !error) return new Response(`No menu for "${slug}"`, { status: 404 });
if (error) return new Response(`Menu unavailable: ${error}`, { status: 503 });

// Is this the theme editor looking at itself? The listener below is emitted ONLY then,
// so a diner's page never contains a way to repaint it from another window - not gated at
// runtime, absent from the bytes.
const isPreview = Astro.url.searchParams.has("preview");

const cfg = menu.config;
const mode = themeMode(cfg);
const lang = (menu.tenant.languages || ["en"])[0];
const template = SHEETS[menu.tenant.template] ? menu.tenant.template : DEFAULT_TEMPLATE;
const sheet = SHEETS[template];
const title = cfg.site_name || menu.tenant.name;
// Both palettes, each scoped to its own `data-theme`, plus the settings that reach CSS.
// Scoped rather than flat so the restaurant's colours beat the template's defaults AND so
// the day/night button has something to switch between - see `paletteCss`.
const palette = paletteCss(cfg);
const settings = settingsCss(cfg);
// The settings the deferred bundle needs at runtime: hero art, the venue block, the
// links. SETTINGS only - a few hundred bytes, never the menu, which is already in the
// markup. `init.js` reads this and starts the hero video, the photo crossfade, the
// address/hours block and the delivery links exactly the way the platform starts them.
const RUNTIME_KEYS = [
  "hero_images", "hero_image_url", "hero_video_url", "hero_video_mobile_url",
  "hero_video_poster_url", "hero_logo_url", "hero_min_h", "spin_enabled",
  "site_address", "site_hours_range", "site_hours_note", "site_map_url",
  "instagram_url", "google_review_label", "google_review_url",
  "delivery_label", "delivery_url", "delivery_icon",
  "delivery2_label", "delivery2_url", "delivery2_icon",
  "drink_categories", "site_name", "site_name_ka",
];
const runtimeCfg = Object.fromEntries(
  RUNTIME_KEYS.filter((k) => cfg[k]).map((k) => [k, cfg[k]]));
// The one non-setting in here, and the only id a diner's page ever carries: which
// restaurant to file its counts under (0009_events). It is not a secret - it is in the URL
// as a slug already - and the sink refuses ids that are not real restaurants.
runtimeCfg.tenant_id = menu.tenant.id;

// Who may repaint this page in preview. The admin, and nothing else. Configured rather
// than inferred from the referrer, because a referrer is whatever the other side says.
const previewOrigins = envFrom(Astro.locals)(
  "PREVIEW_ORIGINS", "http://127.0.0.1:3001,http://localhost:3001")
  .split(",").map((s) => s.trim()).filter(Boolean);
// Sizes and add-ons, keyed by index, for the ~18% of dishes that have any. The only two
// fields the viewer needs that are NOT recoverable from the markup - see `itemsJson`.
const items = itemsJson(menu);
const buildMs = Date.now() - started;
---
<!doctype html>
<html
  lang={lang}
  data-template={template}
  data-theme={mode}
  data-tenant={menu.tenant.slug}
  data-brand-slug={menu.tenant.slug}
  data-phone-layout={cfg.phone_layout || "list"}
  data-hero-image={cfg.hero_image_url ? "true" : undefined}
  data-generic-hero={cfg.hero_image_url ? "true" : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Menu</title>
    <meta name="description" content={`${title} menu`} />
    {cfg.hero_image_url && (
      <link rel="preload" as="image" href={cfg.hero_image_url} fetchpriority="high" />
    )}
    {/* The template's stylesheet FIRST, the restaurant's palette after it.
        Order matters: the sheet carries its own `[data-theme="day"]` defaults, and a
        palette written before it loses every tie. This is the restaurant's own theme -
        it wins. */}
    <style set:html={sheet} />
    {/* The restaurant's palette, before a single pixel is painted. The platform sets
        these at runtime after fetching theme_config, which is the re-skin a diner
        watches happen; resolved here, there is no second state to flash to. */}
    <style set:html={palette + (settings ? `:root{${settings}}` : "")} />
    <Fragment set:html={fontLinks(cfg)} />
  </head>
  <body>
    <Fragment set:html={toggles(menu)} />
    <Fragment set:html={hero(cfg)} />
    <Fragment set:html={header(menu, cfg, lang)} />
    <Fragment set:html={catBar(menu, lang)} />
    <Fragment set:html={menuList(menu, lang)} />

    {/* The 3D modal, the AR overlay, the lightbox, the basket, the staff QR. After the
        list, as the platform has them, because two of them are position:fixed and the
        stacking order between the overlays is document order. */}
    <Fragment set:html={chromeHtml} />

    {/* Everything interactive - the category filter, the 3D modal, AR, the WebXR
        carousel - in one cached file that every tenant shares, loaded after the menu is
        already readable. `defer` keeps it off the parser's critical path entirely. */}
    {/* Settings for the deferred bundle. `</` is escaped because a closing tag inside
        JSON would end the script early - the standard fix, and cheaper than a request. */}
    <script
      is:inline
      set:html={`window.__CFG=${JSON.stringify(runtimeCfg).replace(/</g, "\\u003c")};` +
        `window.__ITEMS=${JSON.stringify(items).replace(/</g, "\\u003c")};`}
    />
    {/* Everything interactive - the category filter, the 3D modal, AR, the WebXR
        carousel, the hero video and crossfade - in one cached file every tenant shares,
        loaded after the menu is already readable. `defer` keeps it off the parser's
        critical path entirely. */}
    <script
      is:inline
      defer
      src="/viewer.js"
      data-lang={lang}
      data-build-ms={String(buildMs)}
    />

    {/* The theme editor's live preview, and nothing else.
     *
     * The admin used to draw its own mock of this page - hand-written markup, emoji
     * instead of dishes, and about twenty-five of the forty-one custom properties
     * re-implemented by hand. It could not show a template's own CSS rules at all, so an
     * owner was tuning colours against a drawing of their menu rather than their menu.
     *
     * This is the real page. The editor puts it in a frame and posts the palette as it is
     * typed; every value is a CSS custom property already, so applying one live is exactly
     * what the renderer does at publish time.
     *
     * Only present when `?preview` is in the URL, and only accepts messages from an origin
     * we name. A page that can be repainted by any window that gets a handle on it is a
     * page that can be made to say anything. */}
    {isPreview && (
      <script is:inline set:html={`(function(){
  var ALLOWED = ${JSON.stringify(previewOrigins)};
  var root = document.documentElement;
  addEventListener("message", function (e) {
    if (ALLOWED.indexOf(e.origin) < 0) return;
    var m = e.data;
    if (!m || m.type !== "br-theme") return;
    if (m.mode === "day" || m.mode === "night") root.setAttribute("data-theme", m.mode);
    if (m.template) root.setAttribute("data-template", m.template);
    var vars = m.vars || {};
    for (var k in vars) {
      if (!Object.prototype.hasOwnProperty.call(vars, k)) continue;
      // Names are ours (the varMap) and values are bounded by the sender. Anything that
      // is not a custom property is ignored rather than cleaned: a half-sanitised
      // gradient renders wrong, which is worse than one that never arrives.
      if (k.slice(0, 2) !== "--") continue;
      if (vars[k]) root.style.setProperty(k, vars[k]);
      else root.style.removeProperty(k);
    }
    if (m.reload) location.reload();
  });
  // Click-to-edit. Tapping a part of the menu tells the editor which colour governs it,
  // and the editor jumps to that row. The map comes from the editor rather than being
  // written here twice - one definition owns the label, the grouping and the target.
  var PICK = [];
  addEventListener("message", function (e) {
    if (ALLOWED.indexOf(e.origin) < 0) return;
    if (e.data && e.data.type === "br-pick-map" && Array.isArray(e.data.map)) PICK = e.data.map;
  });

  document.addEventListener("click", function (ev) {
    if (!PICK.length) return;
    // A click lands on the innermost element, so walk OUT until something matches. The
    // map is ordered most-specific-first, so the first hit at each level is the right one.
    for (var el = ev.target; el && el !== document; el = el.parentElement) {
      for (var i = 0; i < PICK.length; i++) {
        try {
          if (el.matches && el.matches(PICK[i][0])) {
            ev.preventDefault();
            ev.stopPropagation();
            parent.postMessage({ type: "br-preview-pick", field: PICK[i][1] }, "*");
            return;
          }
        } catch (_) { /* a selector we cannot parse is a selector we skip */ }
      }
    }
  }, true);

  // In preview the page is a swatch, not a menu: opening the 3D modal or following a
  // delivery link would take the editor somewhere it cannot come back from.
  document.addEventListener("submit", function (e) { e.preventDefault(); }, true);
  document.querySelectorAll("a[href]").forEach(function (a) {
    a.addEventListener("click", function (e) { e.preventDefault(); });
  });

  // Tell the editor the page is ready for values, so it does not post into a blank frame.
  try { parent.postMessage({ type: "br-preview-ready" }, "*"); } catch (_) {}
})();`} />
    )}
  </body>
</html>
