out/
.env
__pycache__/
*.pyc
dataset/
store/
deploy/env.yaml
app/node_modules/
app/.astro/
app/dist/
app/.env

# The Next admin. Same rules as app/ - secrets and build output never committed.
admin/node_modules/
admin/.next/
admin/.env.local
# The production build's public origins. Not secret - they are baked into the
# browser bundle by design - but they are per-deployment, so they are not committed.
admin/.env.production.local
# OpenNext build output: the Worker bundle and the static assets it serves.
admin/.open-next/
admin/.wrangler/
admin/tsconfig.tsbuildinfo

# Cloudflare's local simulator state (the fake R2 bucket wrangler dev writes to)
app/.wrangler/

# Wrangler stores the Cloudflare account id and name here. `admin/.wrangler/` and
# `app/.wrangler/` were already ignored; the one at the repo ROOT was not, which is how it
# got committed. The same directory under app/ has previously held the R2 access key and
# secret inside build sourcemaps, so the rule is the whole path, everywhere.
/.wrangler/
