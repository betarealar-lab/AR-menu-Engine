admin/.env.production.local
# OpenNext build output: the Worker bundle and the static assets it serves.
admin/.open-next/
admin/.wrangler/
admin/tsconfig.tsbuildinfo

# Cloudflare's local simulator state (the fake R2 bucket wrangler dev writes to)
app/.wrangler/
